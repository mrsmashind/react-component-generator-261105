{
  "worktree": {
    "baseRef": "head"
  },
  "permissions": {
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.local)",
      "Read(**/.env.*.local)",
      "Read(**/.env.development)",
      "Read(**/.env.production)",
      "Read(**/.env.staging)",
      "Read(**/.env.test)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/*.pfx)",
      "Read(**/*.keystore)",
      "Read(**/*.jks)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Read(**/id_ecdsa*)",
      "Read(**/credentials)",
      "Read(**/credentials.*)",
      "Read(**/*credential*)",
      "Read(**/*secret*)",
      "Read(**/secrets/**)",
      "Read(**/.secrets/**)",
      "Read(**/.npmrc)",
      "Read(**/.netrc)",
      "Read(**/.aws/**)",
      "Read(**/.ssh/**)",
      "Read(**/.gnupg/**)",
      "Read(**/.docker/config.json)",
      "Read(**/.kube/config)",
      "Read(**/service-account*.json)",
      "Read(**/*.tfvars)",
      "Read(**/*.tfstate)",
      "Read(**/.claude/settings.local.json)",

      "Edit(**/.env)",
      "Edit(**/.env.local)",
      "Edit(**/.env.*.local)",
      "Edit(**/.env.development)",
      "Edit(**/.env.production)",
      "Edit(**/.env.staging)",
      "Edit(**/.env.test)",
      "Edit(**/*.pem)",
      "Edit(**/*.key)",
      "Edit(**/*.p12)",
      "Edit(**/*.pfx)",
      "Edit(**/*.keystore)",
      "Edit(**/*.jks)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Edit(**/id_ecdsa*)",
      "Edit(**/credentials)",
      "Edit(**/credentials.*)",
      "Edit(**/*credential*)",
      "Edit(**/*secret*)",
      "Edit(**/secrets/**)",
      "Edit(**/.secrets/**)",
      "Edit(**/.npmrc)",
      "Edit(**/.netrc)",
      "Edit(**/.aws/**)",
      "Edit(**/.ssh/**)",
      "Edit(**/.gnupg/**)",
      "Edit(**/.docker/config.json)",
      "Edit(**/.kube/config)",
      "Edit(**/service-account*.json)",
      "Edit(**/*.tfvars)",
      "Edit(**/*.tfstate)",

      "Bash(* .env)",
      "Bash(* .env *)",
      "Bash(* .env.*)",
      "Bash(* *.env)",
      "Bash(* */.env)",
      "Bash(* */.env.*)",
      "Bash(* *credential*)",
      "Bash(* *secret*)",
      "Bash(* *.pem)",
      "Bash(* *.key)",
      "Bash(* *id_rsa*)",
      "Bash(* *id_ed25519*)",
      "Bash(* ~/.ssh/*)",
      "Bash(* ~/.aws/*)",
      "Bash(printenv*)",
      "Bash(env)",
      "Bash(env *)",
      "Bash(set)",
      "Bash(Get-Content *.env*)",
      "Bash(type *.env*)"
    ]
  }
}
